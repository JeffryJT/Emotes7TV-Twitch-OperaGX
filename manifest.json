{
  "manifest_version": 3,
  "name": "Custom Emotes GX",
  "version": "1.2",
  "permissions": [],
  "host_permissions": [
    "https://7tv.io/*",
    "https://cdn.7tv.app/*",
    "https://api.betterttv.net/*",
    "https://cdn.betterttv.net/*",
    "https://gql.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}